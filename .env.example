# Build (Cloudflare Pages → Variables, dostępne w czasie builda)
NEXT_PUBLIC_SITE_URL=https://twojadomena.pl
# true dopiero po akceptacji klientki – inaczej noindex + robots Disallow
NEXT_PUBLIC_ALLOW_INDEXING=false
# GA4, ładowane dopiero po zgodzie na cookies analityczne
NEXT_PUBLIC_GA_ID=
# Cloudflare Turnstile (antyspam formularzy) – klucz publiczny
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Pages Functions (Cloudflare Pages → Secrets; lokalnie w pliku .dev.vars)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=
TURNSTILE_SECRET_KEY=
